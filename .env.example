# Copy this file to .env (same folder) and change what you need.
# Everything here has a working default, so .env is optional on one PC.

# MySQL / MariaDB from XAMPP (user root, no password, port 3306). The databases
# attendai and attendai_ithub are created automatically on the first start.
DATABASE_URL=mysql+pymysql://root:@localhost:3306/attendai
# PostgreSQL also works: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE

# Optional. If empty, a random key is made once and kept in backend/data/
# SECRET_KEY=
# WA_BRIDGE_TOKEN=

# Optional: keep the Gmail App Password out of the database
# GMAIL_ADDRESS=teacher@gmail.com
# GMAIL_APP_PASSWORD=abcdefghijklmnop

# Where the React app runs (allowed to call the API)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ports
PORT=5000
WA_BRIDGE_PORT=5100
WA_BRIDGE_URL=http://127.0.0.1:5100
